{
  "name": "zkm-web",
  "private": true,
  "version": "1.0.0",
  "description": "ZKM Java Obfuscator. Corporate site. Vue 3 + Vite, single server deploy.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite-ssg build && pnpm sitemap",
    "preview": "vite preview",
    "lint": "eslint src scripts",
    "sitemap": "node scripts/sitemap.mjs",
    "build-views": "node scripts/buildViews.mjs",
    "images": "node scripts/fetchImages.mjs && node scripts/fetchImages2.mjs",
    "audit": "node scripts/audit.mjs && node scripts/checkTags.mjs"
  },
  "dependencies": {
    "@unhead/vue": "^2.1.17",
    "vue": "^3.4.38",
    "vue-router": "^4.4.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-vue": "^5.1.3",
    "eslint": "^10.12.0",
    "eslint-plugin-vue": "^10.11.1",
    "sharp": "^0.35.5",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.71.2",
    "vite": "^5.4.8",
    "vite-ssg": "^28.3.0",
    "vue-tsc": "^2.1.6"
  },
  "engines": {
    "node": ">=20"
  }
}
